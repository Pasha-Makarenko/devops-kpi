{
	"name": "devops-kpi",
	"version": "1.0.0",
	"author": "Pasha-Makarenko",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"start": "node src/index.js",
		"migrate": "node src/migrate.js",
		"lint:check": "biome check .",
		"lint:fix": "biome check --write .",
		"test:unit": "node --test tests/unit/index.js",
		"test:integration": "node --test tests/integration/index.js",
		"test:coverage": "c8 --check-coverage --lines 40 --functions 35 --branches 30 --statements 40 --include 'src/**/*.js' --exclude 'src/**/*.test.js' --reporter=text --reporter=lcov --report-dir=coverage node --test tests/unit/index.js tests/integration/index.js"
	},
	"dependencies": {
		"@devops-kpi/router": "workspace:*",
		"mariadb": "^3.5.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"c8": "^10.1.3",
		"testcontainers": "^10.16.0"
	}
}
